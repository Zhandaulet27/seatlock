            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Save FIRST_DISTINCT_SEAT_ID as property (first iteration only)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="script">if (vars.get(&quot;SEAT_COUNTER&quot;) == &quot;1&quot;) {
    props.put(&quot;FIRST_DISTINCT_SEAT_ID&quot;, vars.get(&quot;SEAT_ID&quot;))
}</stringProp>
