        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Create seat - distinct pool" enabled="true">
            <stringProp name="HTTPSampler.path">/api/v1/events/${__P(EVENT_ID)}/seats</stringProp>
